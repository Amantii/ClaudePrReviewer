# =============================================================================
# apps/web/.env.local — copy this file to .env.local and fill in your values
# cp apps/web/.env.example apps/web/.env.local
# =============================================================================

# --- NextAuth ---
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=

# The URL the web app is running on (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# --- GitHub OAuth App ---
# Create an OAuth App at https://github.com/settings/developers → OAuth Apps → New OAuth App
#   - Homepage URL: http://localhost:3000
#   - Authorization callback URL: http://localhost:3000/api/auth/callback/github
# After creating, generate a client secret on the app page
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database ---
# Same database as the API — must match apps/api/.env
# Format: postgresql://USERNAME@localhost:5432/prreviewer
DATABASE_URL=postgresql://user@localhost:5432/prreviewer

# --- API URL ---
# URL of the running API server — used by client components to call PATCH /repos/:id
# Must be NEXT_PUBLIC_ prefixed so Next.js includes it in the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3001
