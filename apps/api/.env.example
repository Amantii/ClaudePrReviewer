# =============================================================================
# apps/api/.env — copy this file to .env and fill in your values
# cp apps/api/.env.example apps/api/.env
# =============================================================================

# --- Anthropic ---
# Get your API key from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- GitHub App ---
# Create a GitHub App at https://github.com/settings/apps/new
#   - Webhook URL: your ngrok URL + /webhook (e.g. https://abc123.ngrok-free.app/webhook)
#     Run ngrok first: ngrok http 3001
#   - Permissions → Repository: Pull requests (Read & Write), Contents (Read-only)
#   - Subscribe to events: Pull request
# After creating:
#   - Copy the App ID from the app settings page
GITHUB_APP_ID=

#   - Generate a private key (downloads a .pem file), then convert it to a single line:
#     cat ~/Downloads/your-app.private-key.pem | tr '\n' '\\n'
#   - Paste the output below (keep the \n literals, not real newlines)
GITHUB_PRIVATE_KEY=

#   - Make up any random string and use it as the webhook secret in GitHub App settings
GITHUB_WEBHOOK_SECRET=

# --- Database ---
# Install Postgres: brew install postgresql@16 && brew services start postgresql@16
# Create the database: createdb prreviewer
# Run migrations: cd apps/api && npx prisma migrate dev --name init
# Format: postgresql://USERNAME@localhost:5432/prreviewer
# Your macOS username is usually the Postgres username (no password on fresh Homebrew installs)
DATABASE_URL=postgresql://user@localhost:5432/prreviewer

# --- Server ---
# Port the API listens on (default 3001)
PORT=3001
